PORT=3000
DATABASE_URL=postgresql://worker:worker-local@127.0.0.1:5432/worker_tasks
DATABASE_AUTO_MIGRATE=true
DATABASE_SSL=false
DATABASE_SSL_REJECT_UNAUTHORIZED=true
DATABASE_POOL_SIZE=5

NATS_URL=nats://127.0.0.1:4222
NATS_STREAM=NEO_WORKER_TASKS
NATS_SUBJECT=neo.worker.tasks
NATS_CONSUMER=neo-worker-example
NATS_MANAGE_RESOURCES=true
NATS_MAX_DELIVER=3
NATS_ACK_WAIT_MS=120000
NATS_NAK_DELAY_MS=1000

WORKER_CONCURRENCY=2
SUBMIT_RATE_LIMIT=10
MAX_PENDING_TASKS=100
# Optional: when set, the public dashboard asks for this token before submitting work.
TEST_SUBMIT_TOKEN=
