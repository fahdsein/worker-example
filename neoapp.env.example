# Add the following values to BOTH the Web Service and Worker unless noted.
NODE_ENV=production
DATABASE_AUTO_MIGRATE=true
DATABASE_SSL=false
DATABASE_SSL_REJECT_UNAUTHORIZED=true
DATABASE_POOL_SIZE=5
NATS_STREAM=replace-with-neo-stream-name
NATS_SUBJECT=replace-with-neo-subject
NATS_CONSUMER=replace-with-neo-durable-consumer
NATS_MANAGE_RESOURCES=false
NATS_MAX_DELIVER=3
NATS_ACK_WAIT_MS=120000
NATS_NAK_DELAY_MS=1000

# Worker only.
WORKER_CONCURRENCY=2

# Web Service only.
SUBMIT_RATE_LIMIT=10
MAX_PENDING_TASKS=100
# Optional but recommended when the staging URL is shared.
TEST_SUBMIT_TOKEN=replace-with-a-random-testing-token

# Bind the NEO DB as DATABASE_URL on both services.
# Bind the same NEO Queue as NATS_URL on both services.
# Add NATS_TOKEN or NATS_USER/NATS_PASSWORD only when the binding does not inject them.
